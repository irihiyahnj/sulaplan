# sulaplan (Planet) — Plane 社区版部署配置
# 目标: plan.sula.page → core-prod(167.172.204.19) nginx → plane-proxy:8080
# 生成日期: 2026-08-11  基于官方 deployments/cli/community/variables.env 修改

APP_DOMAIN=CHANGE_ME
APP_RELEASE=CHANGE_ME

WEB_REPLICAS=CHANGE_ME
SPACE_REPLICAS=CHANGE_ME
ADMIN_REPLICAS=CHANGE_ME
API_REPLICAS=CHANGE_ME
WORKER_REPLICAS=CHANGE_ME
BEAT_WORKER_REPLICAS=CHANGE_ME
LIVE_REPLICAS=CHANGE_ME

# 宿主 80/443 被 nginx 占用, plane-proxy 只监听内网 8080, TLS 由宿主 nginx 终结
LISTEN_HTTP_PORT=CHANGE_ME
LISTEN_HTTPS_PORT=CHANGE_ME

WEB_URL=CHANGE_ME
DEBUG=CHANGE_ME
CORS_ALLOWED_ORIGINS=CHANGE_ME
API_BASE_URL=CHANGE_ME

# DB SETTINGS
PGHOST=CHANGE_ME
PGDATABASE=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
POSTGRES_PORT=CHANGE_ME
PGDATA=CHANGE_ME
DATABASE_URL=CHANGE_ME

# REDIS SETTINGS
REDIS_HOST=CHANGE_ME
REDIS_PORT=CHANGE_ME
REDIS_URL=CHANGE_ME

# RabbitMQ Settings
RABBITMQ_HOST=CHANGE_ME
RABBITMQ_PORT=CHANGE_ME
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=CHANGE_ME
AMQP_URL=CHANGE_ME

# SSL 由宿主 nginx 管理, plane-proxy 不启用 ACME
CERT_ACME_CA=CHANGE_ME
TRUSTED_PROXIES=CHANGE_ME
# SITE_ADDRESS 是容器内 Caddy 监听地址(compose 将宿主8080映射到容器80),必须 :80
SITE_ADDRESS=CHANGE_ME
CERT_EMAIL=CHANGE_ME

CERT_ACME_DNS=CHANGE_ME

# 生产密钥 —— 部署前替换
SECRET_KEY=CHANGE_ME
LIVE_SERVER_SECRET_KEY=CHANGE_ME

# MinIO/S3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ENDPOINT_URL=CHANGE_ME
AWS_S3_BUCKET_NAME=CHANGE_ME
USE_MINIO=CHANGE_ME
MINIO_ENDPOINT_SSL=CHANGE_ME
